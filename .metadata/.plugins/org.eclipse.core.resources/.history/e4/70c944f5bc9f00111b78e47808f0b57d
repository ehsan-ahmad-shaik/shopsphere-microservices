			// CONVERTING UserRequest TO UserEntity
			private ProductEntity converToProductEntity(ProductRequest productRequest) 
			{
				return modelMapper.map(productRequest, ProductEntity.class);
			}
			// CONVERTING UserEntity TO UserResponse
			private ProductResponse converToUserResponse(ProductEntity productEntity) {
				return modelMapper.map(productEntity, ProductResponse.class);
			}
	
	
	
}
