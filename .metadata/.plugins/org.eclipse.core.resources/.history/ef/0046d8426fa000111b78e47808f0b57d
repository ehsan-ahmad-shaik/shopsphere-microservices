	@Override
	public OrderResponse createOrder(OrderRequest request) 
	{
		User userbyid = userClient.getUserById(request.getUserId()).orElseThrow(() ->new UserNotFoundException("User not found with this id: " + request.getUserId()));
		System.out.println("\nUser Deatiles : "+userbyid+"\n");
	    // Create OrderEntity
	    OrderEntity order = new OrderEntity();
	    order.setUserId(request.getUserId());
	    order.setCreatedAt(LocalDateTime.now());
	    order.setUpdatedAt(LocalDateTime.now());
	    order.setStatus(request.getStatus());
	    
	    List<OrderItemRequest> itemslist = request.getItems();
	    
	    double totalamt=0;
	    
	    for (OrderItemRequest orderItemRequest : itemslist) 
	    {
	    	Product productById = productClient.getProductById(orderItemRequest.getProductId()).orElseThrow(()-> new ProductNotFoundException("Product not found by this id : "+orderItemRequest.getProductId()));
	    	System.out.println("\nProduct Deatiles : "+productById+"\n");
	    	
	    	if(productById.getId()==orderItemRequest.getProductId() && productById.getStock()>=orderItemRequest.getQuantity()) 
	    	{
	    		double price = productById.getPrice();
	    		int quantity = orderItemRequest.getQuantity();
	    		
	    		totalamt += price*quantity;
	    		
	    	}else {
	    		throw new QuantityMustBeLessThanStockException("Quantity must be less than the stock");
	    	}
	    	
	    	
		}
	    order.setTotalAmount(new BigDecimal(totalamt));
	    
	    OrderEntity savedorder = orderRepository.save(order);
	    
	    List<OrderItemResponse> itemResponses = new ArrayList<>();
	    
	    for (OrderItemResponse orderItemResponse : itemResponses) 
	    {
	    	orderItemResponse.setOrder(savedorder);
		}
	    
	   // order.setItems(itemslist);
	    
	    
	    
	    
	}

