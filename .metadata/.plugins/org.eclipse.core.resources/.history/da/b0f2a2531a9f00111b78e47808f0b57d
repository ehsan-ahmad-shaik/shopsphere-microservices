package com.user.serviceimpl;

import java.time.LocalDateTime;
import java.util.Collections;
import java.util.List;

import org.modelmapper.ModelMapper;
import org.springframework.stereotype.Service;

import com.user.dto.UserRequest;
import com.user.dto.UserResponse;
import com.user.entity.UserEntity;
import com.user.exception.UserNotFoundException;
import com.user.repository.UserRepository;
import com.user.service.UserService;
import lombok.AllArgsConstructor;

@Service
@AllArgsConstructor
public class UserServiceImpl implements UserService 
{
	
	private final UserRepository userRepository;
	private final ModelMapper modelMapper;
	
	// CREATE USER
	@Override
	public UserResponse createUser(UserRequest userRequest) 
	{
		// TODO Auto-generated method stub
		UserEntity newuser = converToUserEntity(userRequest);
		newuser.setCreatedAt(LocalDateTime.now());
		UserEntity saveduser = userRepository.save(newuser);
		return converToUserResponse(saveduser);
	}
	
	

	@Override
	public UserResponse getUserById(Long id) {
		// TODO Auto-generated method stub
		UserEntity user = userRepository.findById(id).orElseThrow(() ->new UserNotFoundException("User not found with id: " + id));
		return converToUserResponse(user);
	}


	@Override
	public List<UserResponse> getAllUsers() {
		// TODO Auto-generated method stub
		List<UserEntity> alluserslist = userRepository.findAll();
		if (alluserslist.isEmpty()) {
	        return Collections.emptyList();
	    }
	    return alluserslist.stream()
	            .map(user -> modelMapper.map(user, UserResponse.class))
	            .toList();
	}


	@Override
	public UserResponse updateUserById(Long id, UserRequest userRequest) {
		// TODO Auto-generated method stub
		UserEntity user = userRepository.findById(id).orElseThrow(() ->new UserNotFoundException("User not found with id: " + id));
		
		user.setName(userRequest.getName());
		user.setEmail(userRequest.getEmail());
		user.setPassword(userRequest.getPassword());
		user.setPhone(userRequest.getPhone());
		user.setAddress(userRequest.getAddress());
		user.setCity(userRequest.getCity());
		user.setState(userRequest.getState());
		user.setPincode(userRequest.getPincode());
		user.setCreatedAt(LocalDateTime.now());
		
		UserEntity updateduser = userRepository.save(user);
		
		return converToUserResponse(updateduser);
	}







	@Override
	public void deleteUserById(Long id) {
