		return null;
	}
	
	
	
	
	// CONVERTING UserRequest TO UserEntity
		private UserEntity converToUserEntity(UserRequest userRequest) 
		{
			return modelMapper.map(userRequest, UserEntity.class);
		}
		// CONVERTING UserEntity TO UserResponse
		private UserResponse converToUserResponse(UserEntity userEntity) {
			return modelMapper.map(userEntity, UserResponse.class);
		}


}
