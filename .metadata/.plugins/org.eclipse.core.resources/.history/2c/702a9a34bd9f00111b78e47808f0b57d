package com.product.dto;

import java.time.LocalDateTime;

import jakarta.validation.constraints.DecimalMin;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Pattern;
import jakarta.validation.constraints.Size;
import lombok.AllArgsConstructor;
import lombok.Data;
import lombok.NoArgsConstructor;

@Data
@AllArgsConstructor
@NoArgsConstructor
public class ProductRequest 
{

	 @NotBlank(message = "Product name must not be null or empty")
	    @Size(min = 2, max = 100, message = "Product name must be between 2 and 100 characters")
	    @Pattern(
	        regexp = "^[A-Za-z][A-Za-z0-9 ]*$",
	        message = "Product name must start with a letter and contain only letters, numbers and spaces"
	    )
	    private String name;


	    @NotBlank(message = "Description must not be null or empty")
	    @Size(
	        min = 10,
	        max = 1000,
	        message = "Description must be between 10 and 1000 characters"
	    )
	    private String description;


	    @NotNull(message = "Price must not be null")
	    @DecimalMin(
	        value = "0.01",
	        message = "Price must be greater than 0"
	    )
	    private Double price;


	    @NotBlank(message = "Category must not be null or empty")
	    @Size(
	        min = 2,
	        max = 50,
	        message = "Category must be between 2 and 50 characters"
	    )
	    @Pattern(
	        regexp = "^[A-Za-z][A-Za-z ]*$",
	        message = "Category must contain only letters and spaces"
	    )
	    private String category;


	    @NotBlank(message = "Brand must not be null or empty")
	    @Size(
	        min = 2,
	        max = 50,
	        message = "Brand must be between 2 and 50 characters"
	    )
	    @Pattern(
	        regexp = "^[A-Za-z][A-Za-z0-9 &.-]*$",
	        message = "Brand contains invalid characters"
	    )
	    private String brand;
	    
	    
	    private LocalDateTime createdAt;
	
	    private LocalDateTime updatedAt;
}
